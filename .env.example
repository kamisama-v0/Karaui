# Copy to .env for local overrides. Never commit .env.
# In CI/CD the whole production .env comes from the ENV_FILE secret, and
# NEXT_PUBLIC_SITE_URL is overwritten from the PRODUCTION_URL variable.

# Canonical public origin (build-time: SEO, OG images, registry URLs).
NEXT_PUBLIC_SITE_URL=https://karaui.kamisama-v0.my.id

# Optional: Google Analytics 4. Leave empty to disable.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
GA_API_SECRET=
