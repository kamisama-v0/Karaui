# Copy to .env for local overrides. Never commit .env.
# Production runs on the VPS (Docker image built by .github/workflows/deploy.yml).
# NEXT_PUBLIC_* are baked in at build time (Dockerfile build args); GA_API_SECRET
# is read at runtime from /opt/apps/karaui/.env on the server.
# NEXT_PUBLIC_SITE_URL defaults to the production origin in lib/site.ts.

# Canonical public origin (build-time: SEO, OG images, registry URLs).
NEXT_PUBLIC_SITE_URL=https://karaui.kamisama-v0.my.id

# Optional: Google Analytics 4. Leave empty to disable.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
GA_API_SECRET=
